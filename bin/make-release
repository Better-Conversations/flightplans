#!/usr/bin/env ruby

require 'bundler/setup'
require 'fileutils'

# Load all courses
require_relative '../source/shared/course_config'
require_relative '../source/bc-course/course'
require_relative '../source/bc-ai-course/course'

# Get command line arguments
suffix = ARGV[0] ? "-#{ARGV[0]}" : ""
course_identifier = ARGV[1]&.downcase  # Optional course identifier parameter

# Create the base json-outputs directory if it doesn't exist
FileUtils.mkdir_p('json-outputs')

# Define available courses with their configurations
COURSES = {
  'bc' => BC_COURSE,
  'bc-ai' => BC_AI_COURSE
}

# Select courses to process
courses_to_process = if course_identifier
  if COURSES.key?(course_identifier)
    [COURSES[course_identifier]]
  else
    puts "Error: Unknown course identifier '#{course_identifier}'"
    puts "Available courses: #{COURSES.keys.join(', ')}"
    exit 1
  end
else
  COURSES.values
end

def get_course_config(course_identifier)
  case course_identifier
  when BC_COURSE
    BC::CONFIG
  when BC_AI_COURSE
    BCAICourse::CONFIG
  else
    raise "Unknown course: #{course_identifier}"
  end
end

# Process selected courses
courses_to_process.each do |course|
  # Get course configuration from the module
  config = get_course_config(course)

  json_output = "json-outputs/#{config.identifier}#{suffix}"

  FileUtils.rm_rf(json_output) if Dir.exist?(json_output)
  FileUtils.mkdir_p(json_output)

  course.modules.each do |flight_plan|
    puts "Rendering Flight Plan for #{config.title} Module #{flight_plan.module_number}..."
    output_json_path = File.join(json_output, "module_#{flight_plan.module_number}.json")
    flight_plan.write_json(output_json_path)
  end
end
