#!/usr/bin/env ruby
# Copyright (c) 2026 Better Conversations Foundation Ltd.
# Licensed under the MIT License. See LICENSE.txt.

# Setup bundler so we can require gems
ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../Gemfile', __dir__)
require 'bundler/setup'

require 'bcf/flightplans'
require 'filewatcher'
require 'httparty'

AFP_HOST = ENV.fetch('AFP_HOST', "https://lon.activeflightplans.com")

if !(ARGV.length == 1 || ARGV.length == 2)
  warn "Usage: #{__FILE__} <flightplan.rb> [existing-key]"
  exit 1
end

FILE = ARGV[0]

def reload
  begin
    # Each load will re-run the code in this ruby process.
    # This means that we may have pre-existing state that messes things up.
    # But for now to allow for vscode to run things we want it to be a ruby file
    # not a shell script so this will work.
    load(FILE)
    BCF::FlightPlans::FLIGHT_PLANS.last
  rescue
    puts "Failed to load..."
  end
end

def update(key)
  flight_plan = reload
  HTTParty.post(
    AFP_HOST + "/s/#{key}/update_with_info",
    headers: {
      "Content-Type" => "application/json"
    },
    body: {
      delivery_session: {
        flight_plan: flight_plan.to_json
      }
    }.to_json
  )

  puts "Pushed changes"
end

def create
  flight_plan = reload
  response = HTTParty.post(
    AFP_HOST + "/delivery_sessions",
    headers: {
      "Content-Type" => "application/json"
    },
    body: {
      delivery_session: {
        flight_plan: flight_plan.to_json,
        start_time: Time.now.utc.iso8601
      }
    }.to_json
  )

  if response.code != 201
    puts "Failed to create session"
    puts response.body
    exit 1
  end

  puts "Created session"
  JSON.parse(response.body)["access_key"]
end

key = if ARGV[1]
        # If we have been given a key push an initial update
        update(ARGV[1])
        ARGV[1]
      else
        create
      end

puts "Test URL:\n#{AFP_HOST}/s/#{key}/delivery_consoles/new"

Filewatcher.new(FILE).watch do |changes|
  update(key)
end
